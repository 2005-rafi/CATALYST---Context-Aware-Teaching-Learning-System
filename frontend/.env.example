# Frontend Environment Template (.env.example)
# For local development, copy to .env.local
# For Vercel production deployment, set in Vercel Project Settings > Environment Variables

# Backend FastAPI URL (Render URL in production or http://localhost:8000 for local)
NEXT_PUBLIC_API_URL=https://catalyst-rag-backend.onrender.com
NEXT_PUBLIC_APP_NAME=CATALYST
NEXT_PUBLIC_POLLING_INTERVAL_MS=2000
