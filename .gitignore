# ==============================================================================
# .gitignore - CATALYST Document Intelligence Platform
# ==============================================================================

# 1. Private Local Documentation (Personal use only)
docs/
*.md.local

# 2. Environment & Secrets (NEVER commit live keys)
.env
.env.*
!.env.example
secrets/.env
secrets/*.key
secrets/*.pem
secrets/*.cert
!secrets/.env.example
frontend/.env.local
frontend/.env.*.local
!frontend/.env.example

# 3. Python & Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
backend/logs/*.log
!backend/logs/.gitkeep

# 4. Node.js & Frontend (Next.js)
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
*.tsbuildinfo
frontend/*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel/
frontend/.vercel/

# 5. Storage & Large Artifacts
storage/
artifacts/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
faiss_index/

# 6. OS & IDE Configuration
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/
.idea/
*.swp
*.swo

# 7. AI Agent Memory & Caches
.agents/
graphify-out/
.gemini/
CLAUDE.md
frontend/CLAUDE.md
frontend/AGENTS.md
.last-run.json
