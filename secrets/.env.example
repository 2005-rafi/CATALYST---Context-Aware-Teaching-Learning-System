# ==============================================================================
# RAG DOCUMENT INTELLIGENCE PLATFORM - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to secrets/.env and add your free Groq API key.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API KEYS & CREDENTIALS
# ------------------------------------------------------------------------------
# Free Groq API Key (Sign up at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: HuggingFace token (not required for local inference)
HF_TOKEN=

# ------------------------------------------------------------------------------
# 2. RUNTIME ENVIRONMENT & LOGGING
# ------------------------------------------------------------------------------
# 'development' (ANSI colored terminal logs) or 'production' (structured file logs)
ENVIRONMENT=development
LOG_LEVEL=INFO
LOGS_PATH=backend/logs

# ------------------------------------------------------------------------------
# 3. LLM PROVIDERS & MODELS (Zero-Cost / Free-Tier)
# ------------------------------------------------------------------------------
# Local Ollama model (e.g. qwen2.5:3b, llama3.2:3b, deepseek-r1:1.5b)
LOCAL_MODEL_NAME=qwen2.5:3b
ENABLE_LOCAL_MODEL=true

# Groq Cloud Models (Free tier: 30 RPM, 14.4k RPD)
GROQ_MODEL_MEDIUM=llama-3.1-8b-instant
GROQ_MODEL_EXPERT=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 4. EMBEDDING & RERANKING MODELS (Local PyTorch / 100% Free)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ------------------------------------------------------------------------------
# 5. RETRIEVAL & CHUNKING PIPELINE HYPERPARAMETERS
# ------------------------------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=100
CHUNK_MIN_SIZE=100

FAISS_TOP_K=50
BM25_TOP_K=50
RRF_CONSTANT=60
RRF_TOP_N=20

CROSS_ENCODER_TOP_N=5
CROSS_ENCODER_MIN_SCORE=0.60
CONTEXT_MAX_CHUNKS=5

RECENT_CHAT_WINDOW=5
SUMMARY_UPDATE_INTERVAL=10

ENABLE_BM25=true
ENABLE_RRF=true
ENABLE_CROSS_ENCODER=true

# ------------------------------------------------------------------------------
# 6. LOCAL PERSISTENT STORAGE PATHS
# ------------------------------------------------------------------------------
DATABASE_PATH=storage/sqlite/app.db
UPLOADS_PATH=storage/uploads/workspaces
FAISS_PATH=storage/vectors/faiss
BM25_PATH=storage/bm25
MODELS_CACHE_PATH=storage/models
OFFLINE_MODE=true
